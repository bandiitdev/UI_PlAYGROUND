QPushButton {
    background-color:transparent;
    color: #222222;
    width: 120px;height: 25px;
    border: none;
    text-align:center;
}
QPushButton:hover{
    Background:#E8E7E2;
    border: none;
    border-radius: 10px;
}

QMainWindow{
    background-color:#F2F2EE;
}

#Sidebar{
    background-color:#DAD8D2;
    border-radius:20px;
}

#card_2_settings_page{
    background-color: #FCFCFA;
    border: 1px solid #D5D2C5;
    border-radius: 12px;
}


